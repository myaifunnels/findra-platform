# Host / database only. Payment, email, maps, R2, and SMS keys are entered
# in Admin → Settings → Integrations and stored in the database.
PORT=4173
NODE_ENV=production

# PostgreSQL-backed accounts. Create a Render PostgreSQL database and use its
# Internal Database URL here. Never place this value in frontend code.
DATABASE_URL=postgresql://findra:replace-with-render-internal-url/findra
# Set false only for a local PostgreSQL server without TLS.
DATABASE_SSL=true

# Set this once to the email address of the first Findra administrator. Remove
# it after that administrator is created.
BOOTSTRAP_ADMIN_EMAIL=admin@findra.ph

# AES-256 key used to encrypt inquiry bodies and integration secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this value stable — rotating it makes previously stored secrets
# undecryptable. Never commit the real value.
MESSAGE_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key
